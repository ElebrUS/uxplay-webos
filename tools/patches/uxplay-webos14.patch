     assert(key);
@@ -208,7 +221,10 @@ x25519_key_t *x25519_key_generate(void) {
         handle_error(__func__);
     }
     if (!EVP_PKEY_keygen(pctx, &key->pkey)) {
-        handle_error(__func__);
+        ensure_entropy_seeded();
+        if (!EVP_PKEY_keygen(pctx, &key->pkey)) {
+            handle_error(__func__);
+        }
     }
     EVP_PKEY_CTX_free(pctx);
 
@@ -386,6 +402,7 @@ ed25519_key_t *ed25519_key_generate(const char *device_id, const char *keyfile,
     }
 
     if (new_pk) {
+        ensure_entropy_seeded();
