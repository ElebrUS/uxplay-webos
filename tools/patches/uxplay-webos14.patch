--- a/lib/crypto.c
+++ b/lib/crypto.c
@@ -49,6 +49,18 @@ uint8_t waste[AES_128_BLOCK_SIZE];
 
 // Common AES utilities
 
+static void ensure_entropy_seeded(void) {
+    unsigned char seed_buf[256];
+    FILE *f = fopen("/dev/urandom", "rb");
+    if (f) {
+        size_t n = fread(seed_buf, 1, sizeof(seed_buf), f);
+        fclose(f);
+        if (n > 0) {
+            RAND_add(seed_buf, (int)n, (double)n);
+        }
+    }
+}
+
