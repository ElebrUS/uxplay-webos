         if (!pctx) {
             handle_error(__func__);
@@ -394,7 +411,10 @@ ed25519_key_t *ed25519_key_generate(const char *device_id, const char *keyfile,
             handle_error(__func__);
         }
         if (!EVP_PKEY_keygen(pctx, &key->pkey)) {
-            handle_error(__func__);
+            ensure_entropy_seeded();
+            if (!EVP_PKEY_keygen(pctx, &key->pkey)) {
+                handle_error(__func__);
+            }
         }
         EVP_PKEY_CTX_free(pctx);
         if (use_keyfile) {
@@ -598,7 +618,13 @@ char *get_md5(char *string) {
 }
 
